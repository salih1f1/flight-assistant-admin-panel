# Copy to .env.local (gitignored) and fill in. Vite reads these at dev-server start.

# Entra External ID (ciamlogin) app registration for the panel. The B2C in the
# names is historical.
VITE_B2C_CLIENT_ID=
VITE_B2C_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
VITE_B2C_KNOWN_AUTHORITY=<tenant>.ciamlogin.com

# Must match the redirect URI on the app registration and the dev server port (5175).
VITE_REDIRECT_URI=http://localhost:5175

# Local API (http launch profile). Point at a deployed API instead if you're not running one.
VITE_API_BASE_URL=http://localhost:5100

# The API's scope. The admin role is read from the access token issued for it.
VITE_API_SCOPE=api://<backend-client-id>/access_as_user
